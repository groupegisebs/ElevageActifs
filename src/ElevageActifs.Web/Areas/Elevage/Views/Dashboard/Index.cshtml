@{
    ViewData["Title"] = "Tableau de bord élevage";
    var accessible = (IReadOnlyList<ElevageActifs.Web.Services.Interfaces.ExploitationOption>)ViewBag.Accessible;
}
<div class="container py-4">
    @if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">@ViewBag.ExploitationName</h1>
            <p class="text-muted mb-0">Pilotage de l'élevage</p>
        </div>
        @if (accessible.Count > 1)
        {
            <form asp-area="Elevage" asp-controller="Context" asp-action="SetExploitation" method="post" class="d-flex gap-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@Url.Action("Index")" />
                <select name="exploitationId" class="form-select" onchange="this.form.submit()">
                    @foreach (var e in accessible)
                    {
                        <option value="@e.Id" selected="@(e.Id == (int)ViewBag.CurrentId)">@e.Name</option>
                    }
                </select>
            </form>
        }
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4 col-lg-2"><div class="card h-100"><div class="card-body"><div class="text-muted small">Effectifs présents</div><div class="fs-3 fw-bold">@ViewBag.EffectifsPresent</div></div></div></div>
        <div class="col-md-4 col-lg-2"><div class="card h-100"><div class="card-body"><div class="text-muted small">Attentes sanitaires</div><div class="fs-3 fw-bold text-warning">@ViewBag.TraitementsAttente</div></div></div></div>
        <div class="col-md-4 col-lg-2"><div class="card h-100"><div class="card-body"><div class="text-muted small">Gestations ouvertes</div><div class="fs-3 fw-bold">@ViewBag.GestationsOuvertes</div></div></div></div>
        <div class="col-md-4 col-lg-2"><div class="card h-100"><div class="card-body"><div class="text-muted small">Stocks bas</div><div class="fs-3 fw-bold text-danger">@ViewBag.StocksBas</div></div></div></div>
        <div class="col-md-4 col-lg-2"><div class="card h-100"><div class="card-body"><div class="text-muted small">Maintenance ouverte</div><div class="fs-3 fw-bold">@ViewBag.InterventionsOuvertes</div></div></div></div>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-primary" asp-controller="Animaux" asp-action="Index">Animaux</a>
        <a class="btn btn-outline-primary" asp-controller="Troupeaux" asp-action="Index">Troupeaux</a>
        <a class="btn btn-outline-primary" asp-controller="Sante" asp-action="Index">Santé</a>
        <a class="btn btn-outline-primary" asp-controller="Reproduction" asp-action="Index">Reproduction</a>
        <a class="btn btn-outline-primary" asp-controller="Actifs" asp-action="Index">Actifs</a>
        <a class="btn btn-outline-primary" asp-controller="Stocks" asp-action="Index">Stocks</a>
        <a class="btn btn-outline-primary" asp-controller="Maintenance" asp-action="Index">Maintenance</a>
        <a class="btn btn-outline-primary" asp-controller="Fournisseurs" asp-action="Index">Fournisseurs</a>
        <a class="btn btn-outline-secondary" asp-controller="Exploitations" asp-action="Index">Exploitations</a>
    </div>
</div>
