@model Animal
@{ ViewData["Title"] = Model.BoucleNumber; }
<div class="container py-4">
    <div class="d-flex justify-content-between mb-3">
        <h1 class="h3">@Model.BoucleNumber</h1>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-primary" asp-action="AddEvent" asp-route-id="@Model.Id">Ajouter événement</a>
            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Modifier</a>
        </div>
    </div>
    <dl class="row">
        <dt class="col-sm-3">RFID</dt><dd class="col-sm-9">@(Model.RfidTag ?? "—")</dd>
        <dt class="col-sm-3">Espèce / Race</dt><dd class="col-sm-9">@Model.Species / @(Model.Race ?? "—")</dd>
        <dt class="col-sm-3">Sexe</dt><dd class="col-sm-9">@Model.Sex</dd>
        <dt class="col-sm-3">Naissance</dt><dd class="col-sm-9">@(Model.BirthDate?.ToString("yyyy-MM-dd") ?? "—")</dd>
        <dt class="col-sm-3">Statut</dt><dd class="col-sm-9">@Model.Statut</dd>
        <dt class="col-sm-3">Troupeau / Lot</dt><dd class="col-sm-9">@(Model.Troupeau?.Name ?? "—") / @(Model.Lot?.Name ?? "—")</dd>
        <dt class="col-sm-3">Enclos</dt><dd class="col-sm-9">@(Model.Enclos?.Name ?? "—")</dd>
    </dl>
    <h2 class="h5 mt-4">Événements</h2>
    <table class="table table-sm">
        <thead><tr><th>Date</th><th>Type</th><th>Poids</th><th>Notes</th></tr></thead>
        <tbody>
        @foreach (var e in Model.Evenements)
        {
            <tr>
                <td>@e.EventDate.ToString("yyyy-MM-dd")</td>
                <td>@e.Type</td>
                <td>@(e.WeightKg?.ToString("N1") ?? "—")</td>
                <td>@e.Notes</td>
            </tr>
        }
        </tbody>
    </table>
    <a asp-action="Index" class="btn btn-link">Retour</a>
</div>
