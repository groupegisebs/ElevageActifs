@model AnimalEvenement
@{ ViewData["Title"] = "Nouvel événement"; }
<div class="container py-4" style="max-width:600px">
    <h1 class="h3 mb-3">Événement — @ViewBag.AnimalLabel</h1>
    <form method="post">
        <input type="hidden" asp-for="AnimalId" />
        <div class="mb-3"><label asp-for="Type" class="form-label"></label><select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<AnimalEvenementType>()"></select></div>
        <div class="mb-3"><label asp-for="EventDate" class="form-label">Date</label><input asp-for="EventDate" class="form-control" type="date" /></div>
        <div class="mb-3"><label asp-for="WeightKg" class="form-label">Poids (kg)</label><input asp-for="WeightKg" class="form-control" /></div>
        <div class="mb-3"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control"></textarea></div>
        <button type="submit" class="btn btn-primary">Enregistrer</button>
        <a asp-action="Details" asp-route-id="@Model.AnimalId" class="btn btn-link">Annuler</a>
    </form>
</div>
