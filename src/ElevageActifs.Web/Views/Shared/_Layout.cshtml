@using ElevageActifs.Web
@using ElevageActifs.Web.Models
@using ElevageActifs.Web.Models.ViewModels
@using ElevageActifs.Web.Options
@using Microsoft.Extensions.Options
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject ElevageActifs.Web.Services.Interfaces.IAppContextService AppContext
@inject IOptions<DemoOptions> DemoOptionsAccessor
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var isAdmin = area == "Admin";
    var isElevage = area == "Elevage";
    var hasSidebar = isAdmin || isElevage;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var app = await AppContext.GetSnapshotAsync();
    var pageTitle = ViewData["Title"]?.ToString() ?? app.AppName;
    var demo = DemoOptionsAccessor.Value;
    var isDemoMode = demo.Enabled;
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name" data-bs-theme="@app.BootstrapColorMode">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - @app.AppName</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ElevageActifs.Web.styles.css" asp-append-version="true" />
    @await Component.InvokeAsync("ThemeStyle")
</head>
<body class="@(isDemoMode ? "has-demo-banner" : null)">
    @if (isDemoMode)
    {
        <div class="demo-mode-banner" role="status">
            <div class="demo-mode-banner-inner">
                <span class="demo-mode-banner-label">
                    <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                    Mode démo
                </span>
                <span class="demo-mode-banner-text">Environnement de démonstration — données fictives</span>
                <a class="demo-mode-banner-link"
                   asp-area=""
                   asp-controller="Contact"
                   asp-action="Promoteur">
                    Contacter le promoteur
                    <i class="bi bi-arrow-right-short" aria-hidden="true"></i>
                </a>
            </div>
        </div>
    }
    <header class="app-topbar">
        <div class="app-topbar-inner">
            <div class="d-flex align-items-center gap-2">
                @if (hasSidebar)
                {
                    <button type="button" class="sidebar-toggle" id="sidebarToggle" aria-label="Menu">
                        <i class="bi bi-list"></i>
                    </button>
                }
                @await Component.InvokeAsync("AppBranding")
                @if (isDemoMode)
                {
                    <a class="demo-mode-badge"
                       asp-area=""
                       asp-controller="Contact"
                       asp-action="Promoteur"
                       title="Contacter le promoteur">
                        DÉMO
                    </a>
                }
            </div>

            @if (!hasSidebar)
            {
                <ul class="app-nav">
                    <li>
                        <a class="app-nav-link @(controller == "Home" ? "active" : "")"
                           asp-area="" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house"></i> @Localizer["Nav.Home"]
                        </a>
                    </li>
                    @if (isAuthenticated)
                    {
                        <li>
                            <a class="app-nav-link"
                               asp-area="Elevage" asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-heart-pulse"></i> Élevage
                            </a>
                        </li>
                        <li>
                            <a class="app-nav-link @(controller == "Profile" ? "active" : "")"
                               asp-controller="Profile" asp-action="Index">
                                <i class="bi bi-person"></i> @Localizer["Nav.Profile"]
                            </a>
                        </li>
                        <gise-permission resource="Dashboard" action="View">
                            <li>
                                <a class="app-nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-grid"></i> @Localizer["Nav.Admin"]
                                </a>
                            </li>
                        </gise-permission>
                    }
                </ul>
            }
            else if (isElevage)
            {
                <div class="app-topbar-title">@pageTitle</div>
            }

            <div class="d-flex align-items-center gap-2">
                @await Component.InvokeAsync("LanguageSelector")
                <partial name="_LoginPartial" />
            </div>
        </div>
    </header>

    <div class="app-shell @(hasSidebar ? "has-sidebar" : "")">
        @if (isAdmin)
        {
            <aside class="app-sidebar" id="appSidebar">
                <div class="app-sidebar-group open" data-group="admin-main">
                    <button type="button" class="app-sidebar-group-toggle" aria-expanded="true">
                        <span>@Localizer["Admin.Section"]</span>
                        <i class="bi bi-chevron-down app-sidebar-chevron" aria-hidden="true"></i>
                    </button>
                    <div class="app-sidebar-group-body">
                        <a class="app-sidebar-link @(controller == "Dashboard" ? "active" : "")"
                           asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-speedometer2"></i> @Localizer["Admin.Dashboard"]
                        </a>
                        <a class="app-sidebar-link @(controller == "Users" || controller == "UserRoles" ? "active" : "")"
                           asp-area="Admin" asp-controller="Users" asp-action="Index">
                            <i class="bi bi-people"></i> @Localizer["Admin.Users"]
                        </a>
                        <a class="app-sidebar-link @(controller == "Roles" ? "active" : "")"
                           asp-area="Admin" asp-controller="Roles" asp-action="Index">
                            <i class="bi bi-person-badge"></i> @Localizer["Admin.Roles"]
                        </a>
                        <a class="app-sidebar-link @(controller == "Reports" ? "active" : "")"
                           asp-area="Admin" asp-controller="Reports" asp-action="Index">
                            <i class="bi bi-bar-chart"></i> @Localizer["Admin.Reports"]
                        </a>
                        <a class="app-sidebar-link @(controller == "Audit" ? "active" : "")"
                           asp-area="Admin" asp-controller="Audit" asp-action="Index">
                            <i class="bi bi-journal-text"></i> @Localizer["Admin.Audit"]
                        </a>
                        <a class="app-sidebar-link @(controller == "Settings" || controller == "Themes" || controller == "Localization" ? "active" : "")"
                           asp-area="Admin" asp-controller="Settings" asp-action="Index">
                            <i class="bi bi-gear"></i> @Localizer["Admin.Settings"]
                        </a>
                    </div>
                </div>

                <div class="app-sidebar-group open" data-group="admin-security">
                    <button type="button" class="app-sidebar-group-toggle" aria-expanded="true">
                        <span>@Localizer["Admin.SecurityDb"]</span>
                        <i class="bi bi-chevron-down app-sidebar-chevron" aria-hidden="true"></i>
                    </button>
                    <div class="app-sidebar-group-body">
                        <gise-permission resource="Permissions" action="Manage">
                            <a class="app-sidebar-link @(controller == "PermissionMatrix" ? "active" : "")"
                               asp-area="Admin" asp-controller="PermissionMatrix" asp-action="Index">
                                <i class="bi bi-check2-square"></i> @Localizer["Admin.Permissions"]
                            </a>
                        </gise-permission>
                        <gise-permission resource="SecuredEndpoints" action="Manage">
                            <a class="app-sidebar-link @(controller == "SecuredEndpoints" ? "active" : "")"
                               asp-area="Admin" asp-controller="SecuredEndpoints" asp-action="Index">
                                <i class="bi bi-diagram-3"></i> @Localizer["Admin.Endpoints"]
                            </a>
                        </gise-permission>
                    </div>
                </div>

                <div class="app-sidebar-group open" data-group="admin-account">
                    <button type="button" class="app-sidebar-group-toggle" aria-expanded="true">
                        <span>@Localizer["Admin.Account"]</span>
                        <i class="bi bi-chevron-down app-sidebar-chevron" aria-hidden="true"></i>
                    </button>
                    <div class="app-sidebar-group-body">
                        <a class="app-sidebar-link" asp-controller="Profile" asp-action="Index">
                            <i class="bi bi-person-circle"></i> @Localizer["Nav.MyProfile"]
                        </a>
                        <a class="app-sidebar-link" asp-area="" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-arrow-left"></i> @Localizer["Admin.BackHome"]
                        </a>
                    </div>
                </div>
            </aside>
        }
        else if (isElevage)
        {
            <aside class="app-sidebar app-sidebar--elevage" id="appSidebar">
                <div class="app-sidebar-brand">
                    <span class="app-sidebar-brand-name">ElevageActifs</span>
                    <span class="app-sidebar-brand-sub">Cheptel</span>
                </div>

                <div class="app-sidebar-group open" data-group="pilotage">
                    <button type="button" class="app-sidebar-group-toggle" aria-expanded="true">
                        <span>Pilotage</span>
                        <i class="bi bi-chevron-down app-sidebar-chevron" aria-hidden="true"></i>
                    </button>
                    <div class="app-sidebar-group-body">
                        <a class="app-sidebar-link @(controller == "Dashboard" ? "active" : "")"
                           asp-area="Elevage" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-speedometer2"></i> Tableau de bord
                        </a>
                        <a class="app-sidebar-link @(controller == "Exploitations" ? "active" : "")"
                           asp-area="Elevage" asp-controller="Exploitations" asp-action="Index">
                            <i class="bi bi-building"></i> Exploitations
                        </a>
                    </div>
                </div>

                <div class="app-sidebar-group open" data-group="cheptel">
                    <button type="button" class="app-sidebar-group-toggle" aria-expanded="true">
                        <span>Cheptel</span>
                        <i class="bi bi-chevron-down app-sidebar-chevron" aria-hidden="true"></i>
                    </button>
                    <div class="app-sidebar-group-body">
                        <a class="app-sidebar-link @(controller == "Animaux" ? "active" : "")"
                           asp-area="Elevage" asp-controller="Animaux" asp-action="Index">
                            <i class="bi bi-emoji-smile"></i> Animaux
                        </a>
                        <a class="app-sidebar-link @(controller == "Troupeaux" ? "active" : "")"
                           asp-area="Elevage" asp-controller="Troupeaux" asp-action="Index">
                            <i class="bi bi-collection"></i> Troupeaux
                        </a>
                    </div>
                </div>

                <div class="app-sidebar-group open" data-group="sante">
                    <button type="button" class="app-sidebar-group-toggle" aria-expanded="true">
                        <span>Santé &amp; repro</span>
                        <i class="bi bi-chevron-down app-sidebar-chevron" aria-hidden="true"></i>
                    </button>
                    <div class="app-sidebar-group-body">
                        <a class="app-sidebar-link @(controller == "Sante" ? "active" : "")"
                           asp-area="Elevage" asp-controller="Sante" asp-action="Index">
                            <i class="bi bi-heart-pulse"></i> Santé
                        </a>
                        <a class="app-sidebar-link @(controller == "Reproduction" ? "active" : "")"
                           asp-area="Elevage" asp-controller="Reproduction" asp-action="Index">
                            <i class="bi bi-diagram-2"></i> Reproduction
                        </a>
                    </div>
                </div>

                <div class="app-sidebar-group open" data-group="operations">
                    <button type="button" class="app-sidebar-group-toggle" aria-expanded="true">
                        <span>Actifs &amp; ops</span>
                        <i class="bi bi-chevron-down app-sidebar-chevron" aria-hidden="true"></i>
                    </button>
                    <div class="app-sidebar-group-body">
                        <a class="app-sidebar-link @(controller == "Actifs" ? "active" : "")"
                           asp-area="Elevage" asp-controller="Actifs" asp-action="Index">
                            <i class="bi bi-tools"></i> Actifs
                        </a>
                        <a class="app-sidebar-link @(controller == "Stocks" ? "active" : "")"
                           asp-area="Elevage" asp-controller="Stocks" asp-action="Index">
                            <i class="bi bi-box-seam"></i> Stocks
                        </a>
                        <a class="app-sidebar-link @(controller == "Maintenance" ? "active" : "")"
                           asp-area="Elevage" asp-controller="Maintenance" asp-action="Index">
                            <i class="bi bi-wrench"></i> Maintenance
                        </a>
                        <a class="app-sidebar-link @(controller == "Fournisseurs" ? "active" : "")"
                           asp-area="Elevage" asp-controller="Fournisseurs" asp-action="Index">
                            <i class="bi bi-shop"></i> Fournisseurs
                        </a>
                    </div>
                </div>

                <div class="app-sidebar-group open" data-group="compte">
                    <button type="button" class="app-sidebar-group-toggle" aria-expanded="true">
                        <span>Compte</span>
                        <i class="bi bi-chevron-down app-sidebar-chevron" aria-hidden="true"></i>
                    </button>
                    <div class="app-sidebar-group-body">
                        <a class="app-sidebar-link" asp-area="" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house"></i> Accueil
                        </a>
                        <a class="app-sidebar-link" asp-controller="Profile" asp-action="Index">
                            <i class="bi bi-person-circle"></i> @Localizer["Nav.MyProfile"]
                        </a>
                        <gise-permission resource="Dashboard" action="View">
                            <a class="app-sidebar-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-grid"></i> @Localizer["Nav.Admin"]
                            </a>
                        </gise-permission>
                    </div>
                </div>
            </aside>
        }

        <main class="app-content" role="main">
            <div class="app-container @(isElevage ? "app-container--elevage" : null)">
                @RenderBody()
            </div>
        </main>
    </div>

    <footer class="app-footer">
        @string.Format(Localizer["Footer.Copyright"].Value, DateTime.UtcNow.Year, app.AppName)
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
